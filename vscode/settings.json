{
  "[javascript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "editor.fontWeight": "400",
  "terminal.integrated.fontWeight": "400",
  "terminal.integrated.fontSize": 12,
  "workbench.startupEditor": "newUntitledFile",
  "explorer.confirmDelete": false,
  "[vue]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "prettier.arrowParens": "avoid",
  "prettier.singleQuote": true,
  "prettier.trailingComma": "es5",
  "vetur.format.defaultFormatterOptions": {
    "js-beautify-html": {
      "wrap_attributes": "force-expand-multiline"
    },
    "prettyhtml": {
      "printWidth": 100,
      "singleQuote": false,
      "wrapAttributes": false,
      "sortAttributes": false
    }
  },
  "[html]": {
    "editor.defaultFormatter": "vscode.html-language-features"
  },
  "explorer.confirmDragAndDrop": false,
  "liveServer.settings.donotShowInfoMsg": true,
  "gruvboxMaterial.diagnosticTextBackgroundOpacity": "50%",
  "gruvboxMaterial.lightWorkbench": "flat",
  "editor.suggest.snippetsPreventQuickSuggestions": false,
  "editor.parameterHints.enabled": false,
  "explorer.compactFolders": false,
  "eslint.format.enable": true,
  "[javascriptreact]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "editor.lineHeight": 16,
  "editor.suggestLineHeight": 20,
  "editor.renderLineHighlight": "gutter",
  "gruvboxMaterial.italicComments": false,
  "editor.cursorWidth": 3,
  "diffEditor.wordWrap": "on",
  "editor.wordWrap": "on",
  "editor.suggestSelection": "first",
  "gruvboxMaterial.colorfulSyntax": true,
  "javascript.updateImportsOnFileMove.enabled": "always",
  "editor.minimap.enabled": false,
  "editor.quickSuggestions": {
    "other": true,
    "comments": false,
    "strings": false
  },
  "files.associations": {
    "*.js": "javascript",
    "*.php": "php",
    "*.module.php": "php"
  },
  "editor.defaultFormatter": "esbenp.prettier-vscode",
  "editor.fontLigatures": false,
  "gruvboxMaterial.darkWorkbench": "high-contrast",
  "prettier.printWidth": 120,
  "vim.cursorStylePerMode.insert": "line",
  "editor.tabSize": 2,
  "vim.incsearch": true,
  "vim.useSystemClipboard": true,
  "vim.useCtrlKeys": true,
  "vim.hlsearch": true,
  "vim.leader": "<space>",
  "vim.handleKeys": {
    "<C-a>": false,
    "<C-f>": false,
    "<C-p>": false
  },
  "liveServer.settings.donotVerifyTags": true,
  "prettier.useEditorConfig": false,
  "[php]": {
    "editor.defaultFormatter": "bmewburn.vscode-intelephense-client"
  },
  "intelephense.environment.phpVersion": "7.4.29",
  "gruvboxMaterial.darkContrast": "hard",
  "gruvboxMaterial.darkPalette": "original",
  "workbench.fontAliasing": "default",
  "bracketPairColorizer.depreciation-notice": false,
  "workbench.sideBar.location": "right",
  "emmet.includeLanguages": {
    "javascript": "javascriptreact"
  },
  "vim.normalModeKeyBindingsNonRecursive": [
    {
      "before": ["enter"],
      "after": [],
      "commands": [
        {
          "command": ":nohl"
        }
      ]
    },
    {
      "before": ["u"],
      "after": [],
      "commands": [
        {
          "command": "undo",
          "args": []
        }
      ]
    },
    {
      "before": ["<C-r>"],
      "after": [],
      "commands": [
        {
          "command": "redo",
          "args": []
        }
      ]
    }
  ],
  "workbench.iconTheme": "vscode-icons",
  "[scss]": {
    "editor.defaultFormatter": "vscode.css-language-features"
  },
  "editor.fontFamily": "SF Mono",
  "vsicons.dontShowNewVersionMessage": true,
  "[css]": {
    "editor.defaultFormatter": "vscode.css-language-features"
  },
  "typescript.updateImportsOnFileMove.enabled": "always",
  "screencastMode.keyboardOptions": {
    "showCommandGroups": true
  },
  "window.zoomLevel": -1,
  "editor.fontSize": 14,
  "prisma.showPrismaDataPlatformNotification": false,
  "vim.commandLineModeKeyBindingsNonRecursive": [],
  "[typescript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "workbench.activityBar.location": "bottom",
  "chat.disableAIFeatures": true,
  "claudeCode.preferredLocation": "panel",
  "claudeCode.useTerminal": true
}